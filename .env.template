# ═══════════════════════════════════════════════
# Edge IoT Discord Bot Framework — 環境變數設定
# ═══════════════════════════════════════════════
# 使用方式：複製此檔案為 .env，填入你的設定值
# 注意：.env 檔案包含敏感資訊，請勿提交至 Git

# ── Discord ──
# 從 Discord Developer Portal 取得的 Bot Token
DISCORD_TOKEN='你的_BOT_TOKEN'

# ── MQTT ──
# MQTT Broker 主機位址
MQTT_BROKER=你的_BROKER位址
# MQTT 埠號（預設 8883 為 TLS 加密連線）
MQTT_PORT=8883
# MQTT 帳號
MQTT_USER=你的_MQTT帳號
# MQTT 密碼
MQTT_PASSWORD=你的_MQTT密碼

# ── 進階設定（有預設值，通常不需修改）──
# 資料庫類型：sqlite（預設）| postgresql（未來支援）
DB_TYPE=sqlite
# 資料庫檔案路徑（僅 sqlite 適用）
DB_PATH=data.db
# 日誌層級：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日誌檔案目錄
LOG_DIR=logs